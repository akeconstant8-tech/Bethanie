# Variables d'environnement de Béthanie — modèle sans valeur secrète.
#
# Le site appelle l'API à la même adresse (/api/...) et utilise Firebase Authentication pour Google.
# Les variables VITE_FIREBASE_* sont publiques et intégrées au bundle du site ; ce ne sont pas des secrets.
#
# En local : copier les valeurs utiles dans .env.local (ignoré par Git).
# Sur Vercel : Project Settings → Environment Variables.

# Configuration de l'application Web Firebase (Project settings → General → Your apps)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Compte de service Firebase Admin (côté serveur uniquement ; ne jamais préfixer par VITE_)
# Sur Vercel, définir ces secrets dans les variables d'environnement du projet.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Port de l'API en local (défaut : 4000)
# PORT=4000

# Dossier de la base SQLite et des photos importées (défaut : server/data ; sur Vercel : /tmp/bethanie)
# DATA_DIR=

# Chemin complet de la base, si différent de DATA_DIR/bethanie.db
# DB_PATH=

# Cookie de session réservé au HTTPS (défaut : false en local ; true sur Vercel)
# COOKIE_SECURE=true

# Mode démo : paiements simulés, le client peut faire avancer sa commande (défaut : true)
# DEMO_MODE=true

# Fournisseur de paiement (défaut : simulation ; voir server/payments.ts)
# PAYMENT_PROVIDER=simulation

# Développement uniquement : adresse de l'API vers laquelle Vite relaie /api (défaut : http://localhost:4000)
# API_URL=http://localhost:4000
