# Variables d'environnement de Béthanie — modèle sans valeur secrète.
#
# Le site (frontend) n'a besoin d'AUCUNE variable : il appelle l'API à la même adresse que lui (/api/...),
# en local comme sur Vercel. Il n'y a ni Firebase ni clé d'API dans le code du site.
#
# Toutes les variables ci-dessous concernent le serveur (API Express) et sont facultatives.
# En local : les mettre dans .env.local (jamais envoyé sur GitHub) ou dans le terminal.
# Sur Vercel : Project Settings → Environment Variables (aucune n'est obligatoire).

# Port de l'API en local (défaut : 4000)
# PORT=4000

# Dossier de la base SQLite et des photos importées (défaut : server/data ; sur Vercel : /tmp/bethanie)
# DATA_DIR=

# Chemin complet de la base, si différent de DATA_DIR/bethanie.db
# DB_PATH=

# Cookie de session réservé au HTTPS (défaut : false en local ; true sur Vercel)
# COOKIE_SECURE=true

# Mode démo : paiements simulés, le client peut faire avancer sa commande (défaut : true)
# DEMO_MODE=true

# Fournisseur de paiement (défaut : simulation ; voir server/payments.ts)
# PAYMENT_PROVIDER=simulation

# Développement uniquement : adresse de l'API vers laquelle Vite relaie /api (défaut : http://localhost:4000)
# API_URL=http://localhost:4000
