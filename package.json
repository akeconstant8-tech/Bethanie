{
  "name": "bethanie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-dev.mjs",
    "dev": "concurrently -k -n api,web -c green,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && vite build",
    "vercel-build": "npm run build && node scripts/build-vercel.mjs",
    "start": "tsx server/index.ts",
    "db:reset": "tsx server/reset.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
